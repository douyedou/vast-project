# ============================================================
# Docker Compose 环境专用配置
#
# 使用方式：
#   docker-compose up -d
#   然后访问 http://localhost:3000
#
# 注意：此文件仅供容器内服务使用，宿主机直接运行请用 .env
# ============================================================

# 数据库连接（指向 postgres 容器）
DATABASE_URL="postgresql://vast_user:vast_password@postgres:5432/vast_db"

# JWT 密钥（开发环境）
JWT_SECRET="DEV_SECRET"

# Ollama 配置（指向 ollama 容器）
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="qwen2.5:3b"

# AI 微服务地址（指向 ai-service 容器）
AI_SERVICE_URL="http://ai-service:8000"

# OnlyOffice 服务器地址（指向 onlyoffice 容器）
ONLYOFFICE_SERVER="http://onlyoffice:80"

# 其他配置
PORT=3000
NODE_ENV=development
